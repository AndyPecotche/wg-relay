# ==============================================================================
# Configuración del Cliente WireGuard para 'proyecto1' (en la máquina local)
# Generada automáticamente por: ./scripts/add-peer.sh proyecto1 10.10.1.2
# ==============================================================================

[Interface]
# Clave privada única de este cliente local
PrivateKey = REEMPLAZAR_CON_CLAVE_PRIVADA_DEL_CLIENTE
# IP asignada a este proyecto en la red VPN
Address = 10.10.1.2/16

[Peer]
# Clave pública del VPS Relay
PublicKey = REEMPLAZAR_CON_CLAVE_PUBLICA_DEL_VPS
# Dirección IP pública o dominio de tu VPS Relay y puerto UDP
Endpoint = vps.tudominio.com:51820
# Permite comunicarse con toda la subred VPN
AllowedIPs = 10.10.0.0/16
# Mantiene abierta la tabla de traducción NAT de tu router/ISP (CGNAT)
PersistentKeepalive = 25

