# ==============================================================================
# wg-relay: Variables de Entorno del Relay VPS
# ==============================================================================

# Dominio base administrado en Cloudflare
BASE_DOMAIN=tudominio.com

# Email de contacto para notificaciones de Let's Encrypt / Certbot
CERTBOT_EMAIL=admin@tudominio.com

# Puerto UDP público expuesto para el handshake de WireGuard
VPN_PORT=51820

# Subred interna de la VPN WireGuard (CIDR /16 permite hasta 65.534 nodos/proyectos)
VPN_SUBNET=10.10.0.0/16
VPN_GATEWAY_IP=10.10.0.1

# Red bridge interna estática de Docker
DOCKER_SUBNET=172.28.0.0/16
WIREGUARD_CONTAINER_IP=172.28.0.2
NGINX_CONTAINER_IP=172.28.0.10
CERTBOT_CONTAINER_IP=172.28.0.20

# Usuario y Grupo de ejecución (UID / GID) para contenedores LinuxServer
PUID=1000
PGID=1000

# Zona horaria del servidor
TZ=UTC

