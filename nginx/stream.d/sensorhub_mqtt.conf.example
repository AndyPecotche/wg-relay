# ==============================================================================
# Ingress Proxy Layer 4 (Stream): MQTTS (TCP Puerto 8883)
# Terminación TLS en el VPS Relay -> Forwarding en plano al Broker EMQX (10.10.1.2:1883)
# ==============================================================================

server {
    listen 8883 ssl;

    # Certificados TLS Wildcard
    ssl_certificate     /etc/letsencrypt/live/tudominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tudominio.com/privkey.pem;

    # Protocolos y Ciphers SSL seguros
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL_MQTT:10m;
    ssl_session_timeout 4h;

    # Timeouts adaptados a protocolos de telemetría IoT persistentes (MQTT Keep-Alive)
    # Permite mantener túneles abiertos sin desconexiones prematuras
    proxy_timeout 1h;
    proxy_connect_timeout 10s;

    # Reenvío a través del túnel WireGuard hacia el broker MQTT local del peer
    proxy_pass 10.10.1.2:1883;
}
