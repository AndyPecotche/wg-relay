# ==============================================================================
# Ingress Gateway L7: proyecto1
# ==============================================================================
# Patrón Ingress por Proyecto:
# Esta es la ÚNICA configuración requerida en el VPS para todo el proyecto.
# Captura 'proyecto1.tudominio.com' y TODOS sus subdominios ('*.proyecto1.tudominio.com')
# y reenvía el tráfico hacia el Nginx local de proyecto1 (10.10.1.2:80).
# Luego, el Nginx local de tu proyecto se encarga de repartir internamente a
# tus microservicios (api, dashboard, grafana, etc.) sin volver a tocar el VPS.
# ==============================================================================

# Redirección global HTTP (Puerto 80) -> HTTPS (Puerto 443)
server {
    listen 80;
    server_name proyecto1.tudominio.com *.proyecto1.tudominio.com;

    location / {
        return 301 https://$host$request_uri;
    }
}

# Servidor Seguro HTTPS (Puerto 443)
server {
    listen 443 ssl;
    http2 on;
    # Acepta el dominio principal del proyecto y cualquier subservicio (ej. api.proyecto1.tudominio.com)
    server_name proyecto1.tudominio.com *.proyecto1.tudominio.com;

    # Certificados Wildcard gestionados por Certbot (DNS-01 Cloudflare)
    ssl_certificate     /etc/letsencrypt/live/tudominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tudominio.com/privkey.pem;

    # Cabeceras de Seguridad
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 64M;

    # Delegación completa hacia el Nginx LOCAL del proyecto a través de WireGuard
    location / {
        proxy_pass http://10.10.1.2:80;

        # CRÍTICO: Preserva el Host solicitado (ej. api.proyecto1... o proyecto1...)
        # para que el Nginx local sepa a qué contenedor o servicio interno despacharlo
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Timeouts de proxy
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 8 8k;
    }
}

