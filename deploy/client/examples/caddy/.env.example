# NO versionar: contiene el token.
WGRELAY_TOKEN=wgr_...
WGRELAY_VERSION=v1

# Se completa DESPUÉS del primer arranque, con el dominio que imprime el agente.
WGRELAY_DOMAIN=

# Contacto para Let's Encrypt.
ACME_EMAIL=vos@ejemplo.com

# Mientras probás, usá la CA de staging para no gastar cuota (los certificados
# no serán confiables: el navegador va a advertir, y curl necesita -k).
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
