# ---- Dominios (todos configurables; nada está fijo en el código) -----------
# Bajo este dominio se crean los subdominios de los clientes.
WGRELAY_BASE_DOMAIN=clients.wg-relay.wgr.com.ar
# Nombre con un registro A por cada nodo. Los clientes apuntan acá sus CNAME.
WGRELAY_EDGE_HOST=wg-relay.wgr.com.ar
# Dominio de la API (registro A a esta VM).
WGRELAY_API_DOMAIN=api.wg-relay.wgr.com.ar
# Contacto para Let's Encrypt (certificado de la API).
WGRELAY_ACME_EMAIL=

# Para pruebas, usar staging y no gastar cuota de Let's Encrypt:
# WGRELAY_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# ---- Base de datos --------------------------------------------------------
# Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Cloudflare (opcional) ------------------------------------------------
# Si se completa, la API crea sola los registros DNS de cada cliente.
# Token con permiso Zone > DNS > Edit sobre la zona del dominio base.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ---- DNS propio (opcional, alternativa a Cloudflare) ----------------------
# Sin token ni cuota: los nodos sirven ellos mismos WGRELAY_BASE_DOMAIN como
# DNS autoritativo. Requiere delegar ese subdominio por NS en el registrador
# (instrucciones en docs/DEPLOY.md) y que al menos un nodo tenga
# WGRELAY_DNS_LISTEN + --public-ip cargada. CSV de los FQDN de nameserver que
# declaraste en el registrador, ej. ns1.wg-relay.wgr.com.ar,ns2...:
WGRELAY_DNS_NS_NAMES=
WGRELAY_DNS_SOA_EMAIL=

# ---- Nodo de esta VM ------------------------------------------------------
# Se obtiene con: docker compose exec api wgrelay-api node create ...
WGRELAY_NODE_TOKEN=
